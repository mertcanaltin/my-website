---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="site-name">{SITE_TITLE}</a>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		height: var(--space-8);
		max-width: var(--width);
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.site-name {
		font-size: var(--text-base);
		font-weight: 500;
	}
</style>
